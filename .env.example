# Copy to .env and fill in. Used by docker-compose.yml.

# Public domain Caddy serves HTTPS on.
# For Tailscale-only access use your tailnet name (e.g. myhost.tailXXXX.ts.net)
# and switch the Caddyfile to `tls internal` — see caddy/Caddyfile.
DOMAIN=myflix.example.com

# Absolute path on the host to your media library (mounted read-only).
MEDIA_PATH=/srv/media

# How Jellyfin should advertise itself in absolute URLs. Match your public URL.
PUBLIC_URL=https://myflix.example.com/jellyfin

# Container timezone (e.g. Europe/London).
TZ=UTC
